# Public path the built app will be served from. Vite sees this as `base`,
# and the deploy script appends it to DEPLOY_DIR so the rsync target lands
# in the same directory tree the app expects to be served from.
# Must include both leading and trailing slashes (the deploy script
# normalises if you forget).
BASE_PATH=/cubedex/

# SSH host (or user@host) used as the rsync destination prefix.
DEPLOY_HOST=est.org

# Directory on DEPLOY_HOST (relative to the SSH login's CWD, typically
# $HOME) into which BASE_PATH is appended. The deployed files will land in
# DEPLOY_HOST:DEPLOY_DIR/BASE_PATH/ — e.g. est.org:est.org/cubedex/.
DEPLOY_DIR=est.org
